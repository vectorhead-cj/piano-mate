{
  "name": "piano-mate",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "version:next": "node scripts/version.mjs",
    "test:watch": "vitest",
    "corpus:setup": "python3 -m venv tools/corpus/.venv && tools/corpus/.venv/bin/pip install -r tools/corpus/requirements.txt",
    "corpus:extract": "tools/corpus/.venv/bin/python -I tools/corpus/extract.py",
    "corpus:report": "vite tools/corpus/report",
    "corpus": "npm run corpus:extract && npm run corpus:report",
    "corpus:export": "node tools/corpus/export.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "jszip": "^3.10.1",
    "opensheetmusicdisplay": "^2.2.1"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
